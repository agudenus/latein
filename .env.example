# polyarb — example environment file. Copy to `.env` (gitignored) and fill in.
#
# NEVER commit a real `.env`, and never put a private key or wallet credential in any
# file: Phase A needs none, and Phase B will read them from deployment secrets only
# (see CLAUDE.md, Wallet & Security Rules).

# --- Alerts (optional) -------------------------------------------------------------
# Telegram Bot API credentials for `polyarb run` alerts and daily summaries.
# When either is unset, alerts degrade to the JSONL event log (logs/events.jsonl).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Config overrides (all optional; see config/default.toml) -----------------------
# POLYARB_CONFIG=config/default.toml
# POLYARB_MODE=dry-run
# POLYARB_GAMMA_BASE_URL=https://gamma-api.polymarket.com
# POLYARB_CLOB_BASE_URL=https://clob.polymarket.com
# POLYARB_PER_TRADE_CAP_USD=50
# POLYARB_NET_FLOOR_DEFAULT=0.005      # scan.floors.default.taker
# POLYARB_ALERT_MIN_NET=0.01
# POLYARB_SCAN_INTERVAL_SECS=5
# POLYARB_STREAM_ENABLED=true          # false = REST polling only
# POLYARB_STREAM_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# POLYARB_DB_PATH=data/polyarb.sqlite
# POLYARB_LOG_DIR=logs
# POLYARB_REPORT_DIR=reports
